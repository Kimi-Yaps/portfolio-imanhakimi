<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
  AddType text/xml .xml
  AddType model/gltf-binary .glb
  AddType font/woff2 .woff2
</IfModule>

# ==============================================================================
# PERFORMANCE: GZIP COMPRESSION (Core Web Vitals / TTFB optimization)
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml font/woff2
</IfModule>

# ==============================================================================
# PERFORMANCE: BROWSER CACHING (mod_expires)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 2 days"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType model/gltf-binary "access plus 1 year"
</IfModule>

# ==============================================================================
# SECURITY HEADERS (OWASP / Zeriflow / HackTricks Best Practices)
# ==============================================================================
<IfModule mod_headers.c>
  # Clickjacking Protection: Disallow embedding in external frames
  Header set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME-type Sniffing
  Header set X-Content-Type-Options "nosniff"

  # Privacy & Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy: Block unused high-risk browser capabilities
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Cross-Site Scripting Protection (for legacy browsers)
  Header set X-XSS-Protection "1; mode=block"

  # HTTP Strict Transport Security (HSTS)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content-Security-Policy (CSP)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https: blob: data:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none';"
</IfModule>

# Block access to hidden files (.git, .env, etc.)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# ==============================================================================
# ROUTE REWRITES (Vue HTML5 History Mode + Pre-rendered static pages)
# ==============================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Map any /icons/ requests to /tech-icons/ to bypass Apache Alias
  RewriteRule ^icons/(.*)$ /tech-icons/$1 [L]

  # Allow direct access to existing files & directories (including prerendered /projects/index.html)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other requests to SPA root fallback
  RewriteRule . /index.html [L]
</IfModule>
