<IfModule mod_mime.c>
  AddType image/svg+xml .svg .svgz
</IfModule>

# ==============================================================================
# SECURITY HEADERS (OWASP / Zeriflow / HackTricks Best Practices)
# ==============================================================================
<IfModule mod_headers.c>
  # Clickjacking Protection: Disallow embedding in external frames
  Header set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME-type Sniffing
  Header set X-Content-Type-Options "nosniff"

  # Privacy & Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy: Block unused high-risk browser capabilities
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # Cross-Site Scripting Protection (for legacy browsers)
  Header set X-XSS-Protection "1; mode=block"

  # HTTP Strict Transport Security (HSTS)
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Content-Security-Policy (CSP)
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https: blob: data:; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none';"
</IfModule>

# Block access to hidden files (.git, .env, etc.)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirect www to non-www canonical URL
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Map any /icons/ requests to /tech-icons/ to bypass Apache Alias
  RewriteRule ^icons/(.*)$ /tech-icons/$1 [L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
